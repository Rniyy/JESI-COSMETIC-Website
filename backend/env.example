PORT=3000
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=jesi_cosmetic
CORS_ORIGINS=null,http://localhost:3000
JWT_SECRET=generate-with-node--e-"console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── Email (password reset + back-in-stock alerts) ──
# Pick ONE option. Leave them all blank to log emails to the console (local dev).
#
# IMPORTANT: Render's FREE plan blocks SMTP ports (25/465/587), so on Render use
# option A or B (they send over HTTPS). SMTP (option C) is fine locally.
#
# A) Brevo API  — free 300 emails/day, no domain needed:
#    1. Sign up at brevo.com, then Senders, Domains & dedicated IPs -> Senders -> add
#       your email address and click the verification link they email you.
#    2. SMTP & API -> API Keys -> generate a key.
#    3. MAIL_FROM must use that verified sender address.
BREVO_API_KEY=
#
# B) Resend API — resend.com. Without your own verified domain it can only send to
#    your own account email, so it suits testing. Use MAIL_FROM="JESI <onboarding@resend.dev>".
RESEND_API_KEY=
#
# C) SMTP (local development / paid hosting only)
#    Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
#           SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-character App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
#
# Optional: force a provider (brevo | resend | smtp). Normally auto-detected.
MAIL_PROVIDER=
# ── Online payments: ABA PayWay (cards, ABA Pay, KHQR) ──
# Leave blank to keep the demo 4-digit PIN checkout (no real money).
# SANDBOX: sign up at https://sandbox.payway.com.kh/register-sandbox/ — you get test keys by email.
# LIVE: ABA must approve your merchant account first (paywaysales@ababank.com); they then give you
#       live keys and the production URL.
# In your PayWay profile, whitelist the domain of this website (return/callback URL).
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Defaults to the sandbox. Set to the production URL from ABA only when you go live.
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_CURRENCY=USD
# Safety: with PayWay keys set, the demo PIN payment is switched OFF automatically.

# Where "Contact us" messages are emailed (defaults to the address in MAIL_FROM).
CONTACT_EMAIL=
# "From" shown to customers. With Brevo this email must be a verified sender.
MAIL_FROM="JESI-COSMETIC <you@gmail.com>"

# Base URL the frontend is served from — used to build links in emails
# (password reset, back-in-stock). Point this at wherever reset-password.html
# and shop.html are actually served from.
FRONTEND_URL=http://localhost:3000

# ── Image storage (Cloudinary) ──
# Free account at https://cloudinary.com — copy the three values from the dashboard.
# Leave blank for local development: photos are then saved in backend/uploads/.
# On Render, set these three or uploaded photos disappear on every redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
